# Copy this file to `.env` (git-ignored) and fill it in. Never commit `.env`.
#
#   npm run dev:app            tauri dev, with these variables
#   npm run build:app          tauri build, with these variables
#   npm run env -- <command>   any other command, with these variables
#
# A variable already set in your shell wins over this file. In CI the same
# names come from GitHub Environments instead (docs/development.md).

# --- Compiled into the app at build time. PUBLIC: never put a secret here. ---
# Anything compiled in can be read back out of the binary. Comma-separated bare
# host names; leave empty and the feature is unavailable in your build.
LEDGELING_MARKETPLACE_HOSTS=
LEDGELING_ANALYTICS_HOSTS=

# --- Developer and test only. Read at run time by scripts and ignored tests. ---
# Never compiled in. See src-tauri/tests/task_connections.rs for the live tests.
# LEDGELING_TEST_ANTHROPIC_MODEL=
# LEDGELING_TEST_OPENAI_MODEL=
# LEDGELING_TEST_COMPATIBLE_MODEL=
# LEDGELING_TEST_ENDPOINT=
# LEDGELING_TEST_MODEL=
# Path to a built Ledgeling for scripts/benchmark.py and scripts/soak.py.
# LEDGELING_BENCH_BINARY=

# --- Secrets ---
# None yet. Add them here when a script or test needs one, and list the name in
# docs/development.md. A secret goes in this section only, and never reaches the
# app: the app keeps its own keys in the operating system keychain.
