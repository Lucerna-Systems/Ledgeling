{
  "name": "ledgeling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:coding": "tauri dev --features coding",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --features coding",
    "check": "npm run build && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --features coding -- -D warnings",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.41.0",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "monaco-editor": "^0.57.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.0"
  }
}
