{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch", "version": "0.1.0", "identifier": "com.perch.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "macOSPrivateApi": true, "windows": [{ "label": "main", "title": "Perch", "width": 960, "height": 720, "minWidth": 760, "minHeight": 600, "center": true }], "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"], "macOS": { "minimumSystemVersion": "12.0" } }
}
