{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch",
  "version": "0.1.0",
  "identifier": "com.perch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Perch",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "shortDescription": "A little company for your desktop",
    "longDescription": "Perch is a desktop companion that lives on your windows and helps with tasks when asked. Built-in actions run locally; optional AI and web connections use your own provider access. No Perch account or telemetry.",
    "category": "Utility",
    "copyright": "Perch contributors",
    "licenseFile": "../LICENSE.txt",
    "fileAssociations": [
      {
        "ext": [
          "petpack"
        ],
        "name": "Perch pet pack",
        "description": "A Perch pet pack",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../sidecar/bridge.mjs": "sidecar/bridge.mjs",
      "../sidecar/package.json": "sidecar/package.json",
      "../sidecar/node": "sidecar/node",
      "../sidecar/node_modules/": "sidecar/node_modules/"
    }
  }
}
